{{ ansible_managed | comment }}
# A clock lock does not survive a reboot — that is why this is a unit, not a
# command. After= avoids "Unable to set GPU clocks"; the Condition keeps it inert.

[Unit]
Description=Cap the GPU SM clocks at {{ thermal_gpu_clock_cap_min_mhz }}-{{ thermal_gpu_clock_cap_max_mhz }} MHz
Documentation=man:nvidia-smi(1)
After=nvidia-persistenced.service
ConditionPathExists={{ thermal_nvidia_smi_command }}

[Service]
# RemainAfterExit makes the cap a state: `systemctl stop` is what releases it.
Type=oneshot
RemainAfterExit=true
ExecStart={{ thermal_nvidia_smi_command }} -lgc {{ thermal_gpu_clock_cap_min_mhz }},{{ thermal_gpu_clock_cap_max_mhz }}
ExecStop={{ thermal_nvidia_smi_command }} -rgc

# Unhardened on purpose: PrivateDevices and ProtectSystem cut nvidia-smi off
# from /dev/nvidia*.

[Install]
WantedBy=multi-user.target
