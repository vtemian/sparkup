{{ ansible_managed | comment }}
# Native host unit, not a container: monitoring must not depend on GPU-in-container
# plumbing. DCGM is unsupported on this hardware, hence nvidia-smi --query-gpu.

[Unit]
Description=Prometheus nvidia_gpu_exporter (nvidia-smi)
Documentation=https://github.com/utkuozdemir/nvidia_gpu_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ exporters_gpu_user }}
Group={{ exporters_gpu_user }}
ExecStart={{ exporters_bin_dir }}/nvidia_gpu_exporter \
    --web.listen-address=:{{ nvidia_gpu_exporter_port }} \
    --nvidia-smi-command={{ exporters_nvidia_smi_command }} \
    --query-field-names={{ exporters_gpu_query_fields | join(',') }}
Restart=always
RestartSec=5s
TimeoutStopSec=20s
SyslogIdentifier=nvidia_gpu_exporter

# PrivateDevices is deliberately absent: it hides /dev/nvidia* and breaks every
# metric this unit exists for.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
