{
  "uid": "spark-overview",
  "title": "Spark overview",
  "description": "System, GPU and exporter health for the DGX Spark. Provisioned from roles/monitoring/files/dashboards/spark-overview.json — edit in the UI to experiment, then export the JSON and commit it, or the next converge overwrites the change.",
  "tags": ["spark", "system", "gpu"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "GPU",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilisation",
      "description": "Fraction of the sampling window in which at least one kernel was resident. It is an occupancy signal, not an efficiency one: a memory-bound kernel can read 100% while the SMs mostly wait.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_utilization_gpu_ratio{job=\"gpu\"}",
          "legendFormat": "utilisation"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU temperature",
      "description": "temperature.gpu from nvidia-smi. The shutdown and slowdown limit registers read N/A on GB10, so there is no headroom line to draw here — judge it against the hwmon sensors below and against the throttle counters, not against a limit the hardware refuses to report.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_temperature_gpu{job=\"gpu\"}",
          "legendFormat": "GPU"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU power draw",
      "description": "The GPU rail only — roughly half of what the box actually pulls (87 W measured here against 180 W at the socket). It cannot see CPU, memory, NVMe, fans or PSU conversion loss, so never cost a run from this number. Wall power is the `power` job, from the smart plug.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_power_draw_watts{job=\"gpu\"}",
          "legendFormat": "GPU rail"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU clocks",
      "description": "Current graphics and SM clocks. Idle sits near 200 MHz and clocks.max.sm is 3003 MHz on this unit. A clock that sags while utilisation stays high is the visible half of throttling; the throttle counters are the other half.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_clocks_current_graphics_clock_hz{job=\"gpu\"}",
          "legendFormat": "graphics"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nvidia_smi_clocks_current_sm_clock_hz{job=\"gpu\"}",
          "legendFormat": "sm"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unified memory (GPU + CPU)",
      "description": "This is the GPU memory panel. GB10 has unified memory: CPU and GPU share one 121 GiB pool and there is no discrete framebuffer, so nvidia-smi reports memory.used and memory.total as [N/A] and the exporter drops unavailable fields — nvidia_smi_memory_used_bytes does not exist on this box, by design. That absence is correct, not a broken panel, and node_memory_* IS the GPU memory signal. Do not 'fix' it with DCGM's DCGM_FI_DEV_FB_* family: NVIDIA states DCGM does not support Spark, and nvmlDeviceGetMemoryInfo returns NVML_ERROR_NOT_SUPPORTED here.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total" },
            "properties": [
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemAvailable_bytes{job=\"node\"}",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{job=\"node\"}",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Host",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Share of all 20 cores not idle. Ten Cortex-X925 and ten Cortex-A725 are averaged together, so a saturated big-core cluster reads about 50%.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "busy"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Load average",
      "description": "Runnable plus uninterruptible tasks. Read it against the core count drawn alongside: sustained load above it means work is queueing, not just running.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "cores" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load1{job=\"node\"}",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load5{job=\"node\"}",
          "legendFormat": "5m"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load15{job=\"node\"}",
          "legendFormat": "15m"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (cpu) (node_cpu_seconds_total{job=\"node\"}))",
          "legendFormat": "cores"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Uptime",
      "description": "Since the last boot. A reboot is the one operation this box does not survive unattended mid-run, so an unexpectedly small number here is worth explaining.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - node_boot_time_seconds{job=\"node\"}",
          "legendFormat": "uptime",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Temperatures — every hwmon sensor",
      "description": "Everything the kernel exposes under hwmon: the SoC thermal zone and the NVMe sensors. There are no power or energy rails in hwmon on this box, only temperatures — wall power comes from the plug, not from here.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 20,
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_hwmon_temp_celsius{job=\"node\"}",
          "legendFormat": "{{chip}} / {{sensor}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Disk",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "panels": []
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Filesystem usage",
      "description": "Per mounted filesystem. Docker overlays, snap loops and the pseudo-filesystems are excluded at the exporter, which is deliberate: mounting the host root into a containerised node-exporter made the filesystem collector recurse them and hang, and that is why this box had no disk metrics at all until the exporter moved to the host.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (node_filesystem_avail_bytes{job=\"node\"} * 100 / node_filesystem_size_bytes{job=\"node\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Root filesystem — free space",
      "description": "The single 3.7 TB NVMe. There is no separate /home on this box, so datasets, checkpoints, container images and logs all consume the same 3.5 TB of headroom.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["min", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "free on /"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Root filesystem (holds the shared artifact directory)",
      "description": "Datasets, checkpoints and run metadata live in /srv/bbm, outside ~/bbm, because the laptop rsyncs ~/bbm with --delete and would erase anything written there. /srv/bbm is a directory on the root filesystem, not a mount of its own, so node_exporter emits no series for it — a query for mountpoint=\"/srv/bbm\" would match nothing, and these figures are the root filesystem's, which is the pool /srv/bbm actually draws from. Repoint this panel if it ever gets its own filesystem.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "free"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}",
          "legendFormat": "capacity"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Exporter health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Targets up",
      "description": "When telemetry lies, this is the first question: is the exporter alive? 1 is up, 0 is a failed scrape. A flat line at 0 for the gpu job usually means the systemd unit died; a gap means Prometheus itself was down. Never diagnose this by curling the exporter — curl 127.0.0.1:9100 hangs on this box even when node-exporter is healthy.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "lineInterpolation": "stepAfter" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["min", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "legendFormat": "{{job}} — {{instance}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Scrape duration",
      "description": "How long each target takes to answer. A duration climbing toward the scrape interval is an exporter about to start failing — the containerised node-exporter's filesystem hang showed up here before it showed up as a down target.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
