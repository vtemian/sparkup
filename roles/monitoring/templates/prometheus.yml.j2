---
# Managed by Ansible — roles/monitoring/templates/prometheus.yml.j2.
# Edit the template and re-run the playbook; local edits are overwritten.

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  # Prometheus scraping itself. `localhost` is correct here and only here:
  # this target really is inside the container.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # The exporters are systemd units on the host, not containers. From inside
  # this container `localhost` is the container, so the host is named through
  # the host-gateway alias declared in compose.yml.
  - job_name: node
    static_configs:
      - targets: ["host.docker.internal:{{ node_exporter_port }}"]

  - job_name: gpu
    static_configs:
      - targets: ["host.docker.internal:{{ nvidia_gpu_exporter_port }}"]
{% if shelly_enabled %}

  # Wall-socket power. The target is the SPARK, not the plug. The plug speaks
  # Shelly JSON-RPC and serves no metrics at all, so a separate exporter
  # process on the host polls it and speaks Prometheus itself — which puts it
  # on the far side of the same host-gateway alias as node and gpu, for the
  # same reason. `shelly_host` is that exporter's configuration, the device it
  # reads, and is never a target.
  #
  # /prometheus rather than /metrics: the exporter is a Spring Boot app and its
  # actuator serves the exposition format there.
  #
  # Emitted only when the plug is actually on the network: a permanently-red
  # target teaches people to ignore red targets.
  - job_name: power
    metrics_path: {{ shelly_exporter_metrics_path }}
    static_configs:
      - targets: ["{{ shelly_scrape_host }}:{{ shelly_exporter_port }}"]
{% endif %}
