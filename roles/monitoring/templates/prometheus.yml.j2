---
# Managed by Ansible: roles/monitoring/templates/prometheus.yml.j2.
# Edit the template and re-run the playbook; local edits are overwritten.

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

# A glob, and one that legitimately matches nothing: this directory is empty on a
# box where no project has installed rules, and Prometheus is happy with that.
#
# Only root writes here, unlike the dashboards directory in the shared tree that
# any project can drop a board into. The asymmetry is deliberate: a malformed
# dashboard spoils one Grafana panel, while a malformed rule file makes
# Prometheus REFUSE TO START. Group-writable rules would let one user's typo
# take monitoring down at the next reboot, and nothing would connect the two
# events. Roles install rules here, promtool-validated first.
rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  # Prometheus scraping itself. `localhost` is correct here and only here:
  # this target really is inside the container.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Host systemd units, not containers: `localhost` would be the container, so the
  # host is named through the host-gateway alias declared in compose.yml.
  - job_name: node
    static_configs:
      - targets: ["host.docker.internal:{{ node_exporter_port }}"]
    # The textfile collector carries durable records that other projects drop
    # there: immutable rows that do not need re-recording every scrape. It is
    # scraped separately below, slower. `collect[]` and `exclude[]` are
    # mutually exclusive within one job, which is why this is two jobs against
    # one target rather than one job with both.
    params:
      "exclude[]": ["textfile"]

  # Deliberately slower than the rest of the node job. Do NOT raise this past
  # --query.lookback-delta (5m by default): beyond it these series
  # intermittently vanish from instant queries, which is worse than the storage
  # it saves. 60s keeps a 5x margin.
  - job_name: node_textfile
    scrape_interval: {{ prometheus_textfile_scrape_interval }}
    static_configs:
      - targets: ["host.docker.internal:{{ node_exporter_port }}"]
    params:
      "collect[]": ["textfile"]

  - job_name: gpu
    static_configs:
      - targets: ["host.docker.internal:{{ nvidia_gpu_exporter_port }}"]
