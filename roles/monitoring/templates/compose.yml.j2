---
# Managed by Ansible: roles/monitoring/templates/compose.yml.j2.
# Edit the template and re-run the playbook; local edits are overwritten.
#
# Prometheus and Grafana only. The exporters are host systemd units (see the
# exporters role): a containerised node-exporter needs /:/host:ro,rslave, and
# that mount makes the filesystem collector recurse every Docker overlay and
# hang, which is how disk metrics were lost in the first place.

# No container_name: fixing it would stop two stacks (a real one and the test
# harness) coexisting. Service names stay prometheus/grafana for the datasource.
name: {{ monitoring_project_name }}

services:
  prometheus:
    image: {{ prometheus_image }}
    restart: unless-stopped
    # THE TRAP: inside the container `localhost` is the container, so :9100 and
    # :9835 read down. On Linux this alias does not exist unless this line makes it.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      # Alerting and recording rules, installed by roles rather than by users.
      # See the rule_files comment in prometheus.yml.j2 for why this one is not a
      # drop-off directory in the shared tree the way dashboards are.
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - prometheus-data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      # Enables POST /-/reload, so a scrape-config change costs a reload
      # instead of a restart that drops the TSDB head.
      - --web.enable-lifecycle
      # For anything pushing samples with their own timestamps rather than
      # waiting to be scraped, such as a training wrapper emitting per-step
      # metrics. Removing this flag breaks that silently, from the writer's end.
      - --web.enable-remote-write-receiver
    ports:
      # LAN must not reach Prometheus: it is unauthenticated and it accepts
      # remote writes. Bound to loopback, reached through Grafana or an SSH
      # tunnel.
      - "{{ prometheus_bind_address }}:{{ prometheus_port }}:9090"

  grafana:
    image: {{ grafana_image }}
    restart: unless-stopped
    depends_on:
      - prometheus
    ports:
      # Port 80 so http://spark.local needs no suffix. Deliberate, do not
      # "improve" it to 3000.
      - "{{ grafana_port }}:3000"
    environment:
      - GF_SERVER_HTTP_PORT=3000
      # Anonymous on purpose: the point is a dashboard you glance at, and it is
      # bound to the LAN behind ufw rather than exposed.
      - GF_AUTH_ANONYMOUS_ENABLED=true
      - GF_AUTH_ANONYMOUS_ORG_ROLE={{ monitoring_grafana_anonymous_role }}
      - GF_USERS_DEFAULT_THEME={{ monitoring_grafana_theme }}
      - GF_USERS_HOME_PAGE={{ monitoring_grafana_home_dashboard }}
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      # Two sibling mounts under a directory Docker creates in the container's
      # own layer. Neither may be the other's parent: mounting one inside a
      # read-only bind mount fails at container init, because runc has to
      # create the mountpoint and the parent refuses the write.
      - ./grafana/dashboards:{{ monitoring_dashboards_container_dir }}/spark:ro
      # Other projects hand Grafana a dashboard by writing here. The directory
      # is setgid to the shared group, so a job installs its own board without
      # root. The `spark` provider walks its path recursively and picks these
      # up, so this needs no second provider and cannot collide with one.
      - "{{ spark_shared_dir }}/dashboards:{{ monitoring_dashboards_container_dir }}/sparks:ro"
      # Named, and named the same as before the move: dashboards built by hand
      # in the UI live here and nowhere else. Losing this volume loses them.
      - grafana-data:/var/lib/grafana

volumes:
  prometheus-data:
  grafana-data:
