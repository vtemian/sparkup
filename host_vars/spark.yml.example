---
# cp host_vars/spark.yml.example host_vars/spark.yml. Untracked, because it
# names the accounts that get sudo and whose GitHub keys can log in.
#
# The inventory host stays named `spark` whatever your machine is called, so
# this filename is correct either way. Put ansible_user here too if the account
# you SSH in as is not the placeholder in inventory/hosts.yml.

# What the machine is renamed to, and the name it publishes over mDNS, so
# http://<this>.local reaches Grafana. Defaults to `spark`; change it here if you
# want something else, and put the same value in inventory/hosts.yml's
# ansible_host once the first converge has made it resolve.
# spark_hostname: spark

# `groups` is on top of the user's own; the shared group is appended by the role.
# `github_keys` is a GitHub username whose keys are installed, or false.
spark_users:
  - name: you
    groups: [sudo, docker]
    github_keys: false

# Outside any directory a laptop rsyncs with --delete. Renaming this after data
# exists is a migration, not an edit.
spark_shared_dir: /srv/spark
spark_shared_group: spark

# Empty leaves the clock alone.
# base_timezone: Europe/Bucharest

# The name this box takes on your tailnet, so you can reach it from outside the
# house without forwarding a port. Empty does nothing at all. Converging with it
# set installs Tailscale and then tells you the one `tailscale up` to run, which
# needs a browser. roles/tailscale/README.md, and note what becomes reachable:
# Grafana has no login.
# tailscale_hostname: spark

# Whole-system power and energy, from a third-party DKMS module. Uncommenting
# this commits you to a trip to the box: Secure Boot will not load the module
# until you enrol its key at a console screen. roles/spbm/README.md.
# spbm_enabled: true
