---
profile: production

exclude_paths:
  - .git/
  - .github/
  - .worktrees/

# Roles live at the top level of a single-host project, not in a collection,
# so they carry no galaxy metadata.
#
# var-naming[no-role-prefix] is deliberately NOT skipped. A role prefixes what
# it declares (base_timezone); the shared registry it reads (spark_*,
# prometheus_*, node_exporter_*) lives only in group_vars/all.yml, which the
# rule does not constrain. Redeclaring registry variables in role defaults would
# put the same tunable in two files.
skip_list:
  - meta-no-info
